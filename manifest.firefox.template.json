{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "__EXTENSION_VERSION__",
  "default_locale": "de",
  "permissions": ["activeTab", "scripting", "menus", "identity", "alarms", "notifications"],
  "host_permissions": ["__API_ORIGIN__/*"],
  "incognito": "not_allowed",
  "background": { "scripts": ["src/background.js"], "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extensionName__",
    "default_icon": "icon.png"
  },
  "icons": { "48": "icon.png", "96": "icon.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "__EXTENSION_ID__",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["authenticationInfo", "websiteContent"] }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
