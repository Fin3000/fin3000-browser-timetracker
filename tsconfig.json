{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist/timer-types",
    "sourceMap": false,
    "declaration": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"]
}
